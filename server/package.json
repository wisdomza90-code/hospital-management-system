const express = require('express');
const session = require('express-session');
const path = require('path');
const Database = require('better-sqlite3');

// إعداد قاعدة البيانات
const dbPath = path.join(__dirname, 'database.sqlite');
const db = new Database(dbPath);

const app = express();

app.use(express.json());
app.use(express.urlencoded({ extended: true }));

app.use(session({
  secret: 'hospital-management-secret-key',
  resave: false,
  saveUninitialized: false
}));

// ربط مجلد الملفات الثابتة (الواجهة الأمامية) بجوار ملف السيرفر مباشرة
app.use(express.static(__dirname));

// مسار تجريبي للتأكد من عمل السيرفر وقاعدة البيانات
app.get('/api/status', (req, res) => {
  res.json({ status: 'Online', message: 'Hospital Server is running successfully!' });
});

// المسار الرئيسي لفتح الواجهة أو عرض رسالة ترحيبية بدلاً من الشاشة البيضاء
app.get('*', (req, res) => {
  const indexPath = path.join(__dirname, 'index.html');
  res.sendFile(indexPath, (err) => {
    if (err) {
      res.send(
        <div style="font-family: Tahoma; text-align: center; margin-top: 50px;">
          <h2 style="color: #2b6cb0;">نظام إدارة المستشفيات يعمل بنجاح! 🚀</h2>
          <p>السيرفر يعمل الآن وجاهز، يجدر التأكد من رفع ملف واجهة المستخدم (index.html) داخل مجلد server.</p>
        </div>
      );
    }
  });
});

const PORT = process.env.PORT || 10000;
app.listen(PORT, () => {
  console.log(Hospital server is running on port ${PORT} (production));
});
