const express = require('express');
const session = require('express-session');
const path = require('path');
const dbPath = path.join(__dirname, 'database.sqlite');
const Database = require('better-sqlite3');
const db = new Database(dbPath);

const app = express();

// إعدادات البنية الأساسية للتحليل والجلسات
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

app.use(session({
  secret: 'hospital-management-secret-key',
  resave: false,
  saveUninitialized: false
}));

// ربط مجلد الواجهة الأمامية (Frontend) تلقائياً
// إذا كانت ملفات الـ HTML/CSS موجودة في مجلد أعلى أو بجانب السيرفر
app.use(express.static(path.join(__dirname, '../public')));
app.use(express.static(path.join(__dirname, 'public')));

// مسار افتراضي للتأكد من عمل السيرفر وقاعدة البيانات
app.get('/api/status', (req, res) => {
  try {
    const stmt = db.prepare("SELECT name FROM sqlite_master WHERE type='table';").all();
    res.json({ status: 'Online', tables: stmt });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// توجيه الصفحة الرئيسية للواجهة أو عرض رسالة ترحيبية سليمة بدلاً من شاشة "خطأ"
app.get('*', (req, res) => {
  const publicPath = path.join(__dirname, '../public/index.html');
  const localPublicPath = path.join(__dirname, 'public/index.html');
  
  // محاولة إرسال ملف الواجهة الرئيسي إذا وجد، وإلا إرسال رسالة توجيه واضحة
  res.sendFile(publicPath, (err) => {
    if (err) {
      res.sendFile(localPublicPath, (err2) => {
        if (err2) {
          res.send(
            <div style="font-family: Tahoma; text-align: center; margin-top: 50px;">
              <h2 style="color: #2b6cb0;">نظام إدارة المستشفيات يعمل بنجاح! 🚀</h2>
              <p>السيرفر متصل وقاعدة البيانات جاهزة، يجدر التأكد من وجود ملفات الواجهة (Frontend) في مجلد public.</p>
            </div>
          );
        }
      });
    }
  });
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(Server is running on port ${PORT});
});
