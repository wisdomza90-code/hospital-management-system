# انسخ هذا الملف إلى .env ثم عدّل القيم
# (.env لا يُرفع إلى Git لأنه محمي في .gitignore)

# المنفذ الذي يعمل عليه الخادم محليًا.
# المنصات السحابية (Render) تضبط PORT تلقائيًا فلا تحتاج تغييره هناك.
PORT=3000

# بيئة التشغيل: development أو production
# في production تُفعّل الكوكيز الآمنة (تتطلب HTTPS).
NODE_ENV=development

# مفتاح تشفير الجلسات — استخدم سلسلة عشوائية طويلة وسرّية.
# يمكن توليدها بهذا الأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret

# مجلد تخزين ملف قاعدة البيانات SQLite (اختياري).
# عند استخدام قرص دائم على السحابة اضبطه على مسار القرص مثل /data
# DATA_DIR=./data
